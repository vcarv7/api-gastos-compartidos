# Copy this file to .env and adjust the values. Never commit .env.
# Without a dotenv library Django does not read .env by itself; load it
# explicitly, for example:
#
#   uv run --env-file .env python manage.py runserver
#
# Values already present in the shell environment take precedence over the file.


# --- Django ----------------------------------------------------------------

# manage.py, wsgi.py and asgi.py default to config.settings.local.
# Set this to config.settings.produccion when deploying.
DJANGO_SETTINGS_MODULE=config.settings.local

# Required in production. local.py falls back to an insecure development key
# only when this is empty, so production can never share a key by accident.
SECRET_KEY=

# Comma-separated hosts. local.py defaults to localhost,127.0.0.1,[::1].
# Required in production; there is no default there.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# local.py defaults to True. produccion.py ignores this and forces DEBUG=False.
DEBUG=True


# --- Database --------------------------------------------------------------

# Local development uses SQLite at BASE_DIR/db.sqlite3 and ignores DB_*.
# produccion.py requires DB_NAME, DB_USER, DB_PASSWORD and DB_HOST and connects
# to PostgreSQL (needs a PostgreSQL driver such as psycopg installed).
DB_NAME=api_gastos
DB_USER=api_gastos
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432


# --- Email -----------------------------------------------------------------

# local.py always prints emails to the console, ignoring this setting.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com


# --- HTTPS and security (produccion.py only) -------------------------------

CSRF_TRUSTED_ORIGINS=https://example.com
SECURE_SSL_REDIRECT=True

# Only keeps the X-Forwarded-Proto header trusted when running behind a
# reverse proxy that sets it.
USE_X_FORWARDED_PROTO=True

SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
